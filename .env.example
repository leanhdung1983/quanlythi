# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=id6_question_bank
DB_PORT=3306
# Keep certificate verification enabled for remote databases. Only disable for a controlled local test server.
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (optional, for caching to support high concurrency)
REDIS_URL=redis://red-xxxxxxxxxxxxxxxx:6379

# Gemini API Key
GEMINI_API_KEY=

# Security
AUTH_SECRET=
ALLOWED_ORIGINS=https://your-domain.example
# Used only once when the database has no ADMIN account; minimum 12 characters.
ADMIN_INITIAL_PASSWORD=

# Automatic MB -> SePay Pro payments. Disabled until all fields are configured.
PAYMENT_ENABLED=0
PAYMENT_MB_ACCOUNT=
PAYMENT_MB_ACCOUNT_NAME=
# Generate a random secret of at least 32 characters; use the same key in SePay webhook API Key auth.
SEPAY_WEBHOOK_KEY=
PRO_STUDENT_PRICE=200000
PRO_TEACHER_PRICE=300000


# Email (SMTP) Configuration for Password Reset & Notifications
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_app_password
# SMTP_FROM="Hệ thống Khảo thí ID6" <your_email@gmail.com>
# SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
