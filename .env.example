# Database Configuration
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=id6_question_bank
DB_PORT=3306
# Keep certificate verification enabled for remote databases. Only disable for a controlled local test server.
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (optional, for caching to support high concurrency)
REDIS_URL=redis://red-xxxxxxxxxxxxxxxx:6379

# Gemini API Key
GEMINI_API_KEY=

# Security
AUTH_SECRET=
ALLOWED_ORIGINS=https://your-domain.example
# Used only once when the database has no ADMIN account; minimum 12 characters.
ADMIN_INITIAL_PASSWORD=
